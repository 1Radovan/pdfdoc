{
  "$defs": {
    "Block": {
      "description": "Логический блок страницы: абзац, заголовок, таблица, подпись и т.п.",
      "properties": {
        "page": {
          "description": "Номер страницы, с 1",
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "block_id": {
          "description": "Идентификатор вида p{page}_b{NN}",
          "title": "Block Id",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/BlockType"
        },
        "bbox": {
          "description": "[x0, y0, x1, y1] в пунктах PDF (1/72 дюйма), начало координат — левый верхний угол страницы в том виде, как она отображается (с учётом /Rotate)",
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Bbox",
          "type": "array"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        },
        "table_md": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Table Md"
        },
        "table_cells": {
          "anyOf": [
            {
              "items": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Table Cells"
        },
        "html": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Html"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "source": {
          "$ref": "#/$defs/BlockSource"
        },
        "language": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "'ru', 'en', 'mixed' или null (нет букв)",
          "title": "Language"
        },
        "table_spans": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/CellSpan"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Только объединённые ячейки (rowspan/colspan > 1)",
          "title": "Table Spans"
        },
        "table_cell_confidence": {
          "anyOf": [
            {
              "items": {
                "items": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "type": "array"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Уверенность OCR по каждой ячейке (та же форма, что table_cells); null для пустых и перекрытых объединением ячеек",
          "title": "Table Cell Confidence"
        }
      },
      "required": [
        "page",
        "block_id",
        "type",
        "bbox",
        "confidence",
        "source"
      ],
      "title": "Block",
      "type": "object"
    },
    "BlockSource": {
      "description": "Откуда получено содержимое блока.",
      "enum": [
        "text_layer",
        "ocr",
        "table_extractor",
        "table_ocr"
      ],
      "title": "BlockSource",
      "type": "string"
    },
    "BlockType": {
      "description": "Тип блока.",
      "enum": [
        "header",
        "text",
        "list_item",
        "table",
        "signature",
        "page_header",
        "page_footer",
        "page_number",
        "image"
      ],
      "title": "BlockType",
      "type": "string"
    },
    "CellSpan": {
      "description": "Объединённая ячейка таблицы: левый верхний угол и размеры (с нуля).",
      "properties": {
        "row": {
          "minimum": 0,
          "title": "Row",
          "type": "integer"
        },
        "col": {
          "minimum": 0,
          "title": "Col",
          "type": "integer"
        },
        "rowspan": {
          "default": 1,
          "minimum": 1,
          "title": "Rowspan",
          "type": "integer"
        },
        "colspan": {
          "default": 1,
          "minimum": 1,
          "title": "Colspan",
          "type": "integer"
        }
      },
      "required": [
        "row",
        "col"
      ],
      "title": "CellSpan",
      "type": "object"
    },
    "PageInfo": {
      "description": "Навигация по странице: размеры, способ обработки и блоки страницы.",
      "properties": {
        "page": {
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "width": {
          "description": "Ширина страницы в пунктах (как отображается)",
          "title": "Width",
          "type": "number"
        },
        "height": {
          "description": "Высота страницы в пунктах (как отображается)",
          "title": "Height",
          "type": "number"
        },
        "rotation": {
          "default": 0,
          "description": "/Rotate страницы в PDF",
          "title": "Rotation",
          "type": "integer"
        },
        "source": {
          "$ref": "#/$defs/PageSource"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Средняя уверенность по блокам страницы",
          "title": "Confidence"
        },
        "skew_angle": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Исправленный перекос скана, градусы (только для OCR)",
          "title": "Skew Angle"
        },
        "orientation": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Поворот скана на 90/180/270, найденный OSD (только для OCR)",
          "title": "Orientation"
        },
        "block_ids": {
          "items": {
            "type": "string"
          },
          "title": "Block Ids",
          "type": "array"
        },
        "table_ids": {
          "items": {
            "type": "string"
          },
          "title": "Table Ids",
          "type": "array"
        }
      },
      "required": [
        "page",
        "width",
        "height",
        "source"
      ],
      "title": "PageInfo",
      "type": "object"
    },
    "PageSource": {
      "description": "Как обработана страница целиком.",
      "enum": [
        "text_layer",
        "ocr",
        "empty",
        "failed"
      ],
      "title": "PageSource",
      "type": "string"
    }
  },
  "description": "Распознанный PDF-документ.",
  "properties": {
    "file_name": {
      "title": "File Name",
      "type": "string"
    },
    "file_hash": {
      "description": "SHA-256 содержимого PDF, hex",
      "title": "File Hash",
      "type": "string"
    },
    "total_pages": {
      "minimum": 0,
      "title": "Total Pages",
      "type": "integer"
    },
    "pipeline_version": {
      "title": "Pipeline Version",
      "type": "string"
    },
    "processing_time_ms": {
      "minimum": 0,
      "title": "Processing Time Ms",
      "type": "integer"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    },
    "blocks": {
      "items": {
        "$ref": "#/$defs/Block"
      },
      "title": "Blocks",
      "type": "array"
    },
    "pages": {
      "items": {
        "$ref": "#/$defs/PageInfo"
      },
      "title": "Pages",
      "type": "array"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "file_name",
    "file_hash",
    "total_pages",
    "pipeline_version",
    "processing_time_ms"
  ],
  "title": "Document",
  "type": "object"
}
